<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NotificationService</RootNamespace>
    <AssemblyName>notification-service</AssemblyName>
  </PropertyGroup>

  <!-- Exclude the tests/ folder from the main project's compilation.
       The tests/ folder has its own .csproj that compiles those files. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="tests/**" />
    <None Remove="tests\**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>