<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Define the Maven model version. -->
  <modelVersion>4.0.0</modelVersion>
  <!-- Define the project coordinates. -->
  <groupId>com.mediastreamx</groupId><artifactId>service</artifactId><version>1.0.0</version>
  <!-- Configure the Java compiler. -->
  <properties><maven.compiler.source>17</maven.compiler.source><maven.compiler.target>17</maven.compiler.target><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><junit.version>5.10.2</junit.version></properties>
  <!-- Add JUnit only for tests. -->
  <dependencies><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency></dependencies>
  <!-- Configure the Maven test runner. -->
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version><configuration><archive><manifest><mainClass>service.WatchlistService</mainClass></manifest></archive></configuration></plugin></plugins></build>
</project>
